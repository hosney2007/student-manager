# Supabase -> Project Settings -> Database -> Connection string -> URI
# (use the "Transaction pooler" URI on port 6543 for serverless/Vercel)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@aws-0-xx-xxxx-1.pooler.supabase.com:6543/postgres

# any long random string
SECRET_KEY=change-me-to-something-random

# credentials for the admin account auto-created on first run
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-123
